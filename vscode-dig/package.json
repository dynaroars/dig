{
  "name": "vscode-dig",
  "displayName": "VSCode-DIG",
  "description": "A VS Code extension to insert assertions using the 'dig' tool.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.87.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:vscode-dig.insertAssertions",
    "onCommand:vscode-dig.testAssertions",
    "onCommand:vscode-dig.insertCustomAssertions",
    "onCommand:vscode-dig.testAssertionsWithUltimateAutomizer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dynaroars/dig/tree/dig-vscode/vscode-dig"
  },
  "contributes": {
    "commands": [
      {
        "command": "vscode-dig.insertAssertions",
        "title": "Insert Assertions"
      },
      {
        "command": "vscode-dig.testAssertions",
        "title": "Test Assertions"
      },
      {
        "command": "vscode-dig.insertCustomAssertions",
        "title": "Insert Custom Assertions"
      },
      {
        "command": "vscode-dig.testAssertionsWithUltimateAutomizer",
        "title": "Test Assertions with Ultimate Automizer"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorTextFocus",
          "command": "vscode-dig.insertAssertions",
          "group": "navigation"
        },
        {
          "when": "editorTextFocus",
          "command": "vscode-dig.testAssertions",
          "group": "navigation"
        },
        {
          "when": "editorTextFocus",
          "command": "vscode-dig.insertCustomAssertions",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Ultimate Configuration",
      "properties": {
        "ultimate.context": {
          "type": "string",
          "default": "",
          "description": "The path to the Ultimate context directory."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "18.x",
    "@types/vscode": "^1.87.0",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vscode/test-cli": "^0.0.6",
    "@vscode/test-electron": "^2.3.9",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  },
  "license": "MIT",
  "files": [
  "out",
  "resources/dot_sarl"
]

}