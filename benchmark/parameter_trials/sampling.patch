+    def _get_auto_inp_ranges(self):
+        """Bootstrap signed small/source values without Cartesian range probes.
+
+        Ranges remain sampling proposals even if an individual execution fails;
+        an empty trace is not a proof that a whole region is infeasible.
+        """
+        n = len(self.inp_decls)
+        constants = {0, 1, -1, 2, 8, 16}
+        if self.source is not None:
+            from data.symex_c import _preprocess
+            from pycparser import c_ast, c_parser
+            class Constants(c_ast.NodeVisitor):
+                def visit_Constant(self, node):
+                    if node.type == "int":
+                        try:
+                            value = int(node.value, 0)
+                        except ValueError:
+                            return
+                        if abs(value) <= 256:
+                            constants.add(value)
+            try:
+                tree = c_parser.CParser().parse(_preprocess(self.source.read_text()))
+                for node in tree.ext:
+                    if isinstance(node, c_ast.FuncDef) and node.decl.name == settings.MAINQ_FUN:
+                        Constants().visit(node.body)
+            except Exception:
+                pass  # source constants are optional hints
+        seeds = {tuple([value] * n) for value in sorted(constants)}
+        for i in range(n):
+            seed = [1] * n
+            seed[i] = -1
+            seeds.add(tuple(seed))
+        ranges = {tuple([(0, scale)] * n) for scale in (16, 64, 256)}
+        seed_inputs = data.traces.Inps(data.traces.Inp(self.inp_decls.names, seed)
+                                      for seed in sorted(seeds))
+        traces = self._get_traces_mp(seed_inputs)
+        successful = {inp.vs for inp, lines in traces.items() if lines}
+        return ranges, successful
 
